<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Version Header -->
        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="YOLO Detector v1.0"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Confidence Threshold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_conf_threshold"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvConfValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40%"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.1"
            android:valueTo="0.9"
            android:stepSize="0.05"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <!-- IoU Threshold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_iou_threshold"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvIouValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45%"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderIou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.1"
            android:valueTo="0.9"
            android:stepSize="0.05"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <!-- Max Objects -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_max_objects"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvMaxObjectsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMaxObjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="100"
            android:stepSize="1"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <!-- Inference FPS Cap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_inference_fps"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvFpsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 FPS"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="30"
            android:stepSize="1"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <!-- GPU Delegate Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchGpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_gpu_delegate"
            android:textColor="#FFFFFF"
            app:thumbTint="#00E676"
            app:trackTint="#3300E676" />

        <!-- View Mode -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_view_mode"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spViewMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:prompt="@string/view_mode_normal"
            app:backgroundTint="#2C2C2C" />

        <!-- Detection View -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_detection_view"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spDetectionView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:prompt="@string/detection_view_labels"
            app:backgroundTint="#2C2C2C" />

        <!-- View-mode quality controls: only the section for the active view mode is shown -->
        <LinearLayout
            android:id="@+id/layoutEdgeQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_edge_quality"
                android:textColor="#00E676"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_edge_sensitivity"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/tvEdgeThreshold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textColor="#00E676" />
            </LinearLayout>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderEdgeThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="30"
                android:valueTo="200"
                app:thumbColor="#00E676"
                app:trackColorActive="#00E676" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_render_quality"
                android:textColor="#FFFFFF" />
            <Spinner
                android:id="@+id/spEdgeDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:prompt="@string/settings_render_quality"
                app:backgroundTint="#2C2C2C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutHeatmapQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_heatmap_quality"
                android:textColor="#00E676"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_render_quality"
                android:textColor="#FFFFFF" />
            <Spinner
                android:id="@+id/spHeatmapDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:prompt="@string/settings_render_quality"
                app:backgroundTint="#2C2C2C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMatrixQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_matrix_quality"
                android:textColor="#00E676"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_matrix_detail"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/tvMatrixDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8/10"
                    android:textColor="#00E676" />
            </LinearLayout>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMatrixDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="1"
                android:valueTo="10"
                app:thumbColor="#00E676"
                app:trackColorActive="#00E676" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_matrix_shadow_brightness"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/tvMatrixGamma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="74%"
                    android:textColor="#00E676" />
            </LinearLayout>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMatrixGamma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="0.01"
                android:valueFrom="0.50"
                android:valueTo="1.00"
                app:thumbColor="#00E676"
                app:trackColorActive="#00E676" />
        </LinearLayout>

        <!-- Class Filters -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_class_filter"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnSelectVehiclesOnly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Vehicles Only"
                android:textSize="12sp"
                app:backgroundTint="#2C2C2C" />
            <Button
                android:id="@+id/btnSelectAllClasses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="All Classes"
                android:textSize="12sp"
                app:backgroundTint="#2C2C2C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutClassFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Email Alerts -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/email_alerts_header"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/email_enable"
            android:textColor="#FFFFFF"
            app:thumbTint="#00E676"
            app:trackTint="#3300E676" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/email_recipient_hint"
            app:boxBackgroundColor="#2C2C2C"
            app:hintTextColor="#AAAAAA"
            app:startIconDrawable="@drawable/ic_email">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRecipient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/email_sender_hint"
            app:boxBackgroundColor="#2C2C2C"
            app:hintTextColor="#AAAAAA"
            app:startIconDrawable="@drawable/ic_send">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSenderEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/email_api_key_hint"
            app:boxBackgroundColor="#2C2C2C"
            app:endIconMode="password_toggle"
            app:hintTextColor="#AAAAAA"
            app:startIconDrawable="@drawable/ic_key">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvApiKeyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/email_api_key_missing"
            android:textColor="#00E676"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/email_cooldown"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvCooldownValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email_cooldown_value_default"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderCooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:value="60"
            android:valueFrom="30"
            android:valueTo="120"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <Button
            android:id="@+id/btnTestEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/email_test_send"
            android:textSize="13sp"
            app:backgroundTint="#2C2C2C" />
        <TextView
            android:id="@+id/tvTestEmailStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnResetDefaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_reset"
            android:textColor="#000000"
            app:backgroundTint="#757575" />

    </LinearLayout>

</ScrollView>
