<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Version Header -->
        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="YOLO Detector v1.0"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Confidence Threshold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_conf_threshold"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvConfValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40%"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.1"
            android:valueTo="0.9"
            android:stepSize="0.05"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <!-- IoU Threshold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_iou_threshold"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvIouValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45%"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderIou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.1"
            android:valueTo="0.9"
            android:stepSize="0.05"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <!-- Max Objects -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_max_objects"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvMaxObjectsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMaxObjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="100"
            android:stepSize="1"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <!-- Inference FPS Cap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_inference_fps"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tvFpsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 FPS"
                android:textColor="#00E676" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="30"
            android:stepSize="1"
            app:thumbColor="#00E676"
            app:trackColorActive="#00E676" />

        <!-- GPU Delegate Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchGpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_gpu_delegate"
            android:textColor="#FFFFFF"
            app:thumbTint="#00E676"
            app:trackTint="#3300E676" />

        <!-- Class Filters -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_class_filter"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnSelectVehiclesOnly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Vehicles Only"
                android:textSize="12sp"
                app:backgroundTint="#2C2C2C" />
            <Button
                android:id="@+id/btnSelectAllClasses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="All Classes"
                android:textSize="12sp"
                app:backgroundTint="#2C2C2C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutClassFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnResetDefaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_reset"
            android:textColor="#000000"
            app:backgroundTint="#757575" />

    </LinearLayout>

</ScrollView>
