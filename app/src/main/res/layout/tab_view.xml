<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- View Mode -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_view_mode"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spViewMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:prompt="@string/view_mode_normal"
            app:backgroundTint="#2C2C2C" />

        <!-- Detection View -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_detection_view"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spDetectionView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:prompt="@string/detection_view_labels"
            app:backgroundTint="#2C2C2C" />

        <!-- View-mode quality controls: only the section for the active view mode is shown -->
        <LinearLayout
            android:id="@+id/layoutEdgeQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_edge_quality"
                android:textColor="#00E676"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_edge_sensitivity"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/tvEdgeThreshold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textColor="#00E676" />
            </LinearLayout>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderEdgeThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="30"
                android:valueTo="200"
                app:thumbColor="#00E676"
                app:trackColorActive="#00E676" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_render_quality"
                android:textColor="#FFFFFF" />
            <Spinner
                android:id="@+id/spEdgeDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:prompt="@string/settings_render_quality"
                app:backgroundTint="#2C2C2C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutHeatmapQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_heatmap_quality"
                android:textColor="#00E676"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_render_quality"
                android:textColor="#FFFFFF" />
            <Spinner
                android:id="@+id/spHeatmapDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:prompt="@string/settings_render_quality"
                app:backgroundTint="#2C2C2C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMatrixQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_matrix_quality"
                android:textColor="#00E676"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_matrix_detail"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/tvMatrixDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8/10"
                    android:textColor="#00E676" />
            </LinearLayout>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMatrixDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="1"
                android:valueTo="10"
                app:thumbColor="#00E676"
                app:trackColorActive="#00E676" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_matrix_shadow_brightness"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/tvMatrixGamma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="74%"
                    android:textColor="#00E676" />
            </LinearLayout>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMatrixGamma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="0.01"
                android:valueFrom="0.50"
                android:valueTo="1.00"
                app:thumbColor="#00E676"
                app:trackColorActive="#00E676" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>